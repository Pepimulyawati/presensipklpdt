<script setup>
import DashboardLayout from '@/Layouts/DashboardLayout.vue';
import { ref } from 'vue';
import { router, Link, useForm } from '@inertiajs/vue3';

// Props dari Controller
const props = defineProps({ 
  dudis: Object, 
  filters: Object 
});

// State Pencarian
const search = ref(props.filters?.search || '');

// State Modal
const showModal = ref(false);
const isEditMode = ref(false);
const selectedId = ref(null);
const fileInputDudi = ref(null);

// Form Management via useForm Inertia
const form = useForm({
  nama_dudi: '',
  alamat: '',
  kontak: '',
  zona: 'Dalam Kota',
  status_mou: 'aktif',
  // Field khusus untuk tambah instruktur baru sekaligus
  nama_instruktur: '', 
  jabatan: '',
  kontak_instruktur: ''
});

// Handler Pencarian (Real-time)
const doSearch = () => {
  router.get(route('admin.dudi.index'), 
    { search: search.value }, 
    { preserveState: true, replace: true, preserveScroll: true }
  );
};

// Handler Buka Modal Tambah
const openModalAdd = () => {
  isEditMode.value = false;
  form.reset();
  form.clearErrors();
  showModal.value = true;
};

// Handler Buka Modal Edit
const openModalEdit = (dudi) => {
  isEditMode.value = true;
  selectedId.value = dudi.id;
  form.clearErrors();
  
  // Isi form dengan data yang ada
  form.nama_dudi = dudi.nama_dudi;
  form.alamat = dudi.alamat;
  form.kontak = dudi.kontak;
  form.zona = dudi.zona;
  form.status_mou = dudi.status_mou;
  
  showModal.value = true;
};

// Handler Submit (Store & Update)
const submitForm = () => {
  if (isEditMode.value) {
    form.put(route('admin.dudi.update', selectedId.value), {
      onSuccess: () => {
        showModal.value = false;
        form.reset();
      },
    });
  } else {
    form.post(route('admin.dudi.store'), {
      onSuccess: () => {
        showModal.value = false;
        form.reset();
      },
    });
  }
};

// Trigger Input File Excel
const triggerFileSelect = () => {
  fileInputDudi.value.click();
};

// Handler Upload Excel
const handleDudiUpload = (event) => {
  const file = event.target.files[0];
  if (!file) return;

  if (confirm(`Apakah Anda yakin ingin mengimport data dari file "${file.name}"?`)) {
    const formData = new FormData();
    formData.append('file_excel', file);

    router.post(route('admin.dudi.import'), formData, {
      forceFormData: true,
      onSuccess: () => {
        alert('Data Mitra DUDI berhasil diimport!');
        event.target.value = ''; // Reset input file
      },
      onError: (errors) => {
        alert('Gagal mengimport data: ' + (errors.file_excel || 'Terjadi kesalahan sistem'));
        event.target.value = '';
      }
    });
  } else {
    event.target.value = '';
  }
};

// Handler Hapus Data
const deleteDudi = (id) => {
  if (confirm('Hapus data mitra DUDI ini? Seluruh data instruktur di dalamnya juga akan terhapus secara permanen.')) {
    router.delete(route('admin.dudi.destroy', id), {
      onSuccess: () => {
        // Notifikasi berhasil bisa ditambahkan di sini via Flash Session
      }
    });
  }
};
</script>

